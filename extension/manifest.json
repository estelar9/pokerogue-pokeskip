{
  "manifest_version": 3,
  "name": "PokéSkip — Auto-Skip Capacités PokéRogue",
  "version": "1.7.0",
  "description": "Widget natif pour choisir quelles capacités ignorer automatiquement par Pokémon dans PokéRogue. Sauvegarde éternelle par espèce, zéro outil tiers !",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PokéSkip",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://pokerogue.net/*",
        "*://beta.pokerogue.net/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": [
        "*://pokerogue.net/*",
        "*://beta.pokerogue.net/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "pokeskip@antigravity.local",
      "strict_min_version": "109.0"
    }
  }
}
