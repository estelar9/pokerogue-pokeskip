{
  "manifest_version": 3,
  "default_locale": "fr",
  "name": "__MSG_appName__",
  "version": "1.16.1",
  "description": "__MSG_appDesc__",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://pokerogue.net/*",
        "*://beta.pokerogue.net/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": [
        "*://pokerogue.net/*",
        "*://beta.pokerogue.net/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "pokeskip@estelar9",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
